# Every variable the app reads. It is optional; the default is what
# `npm run dev` uses after a local pipeline run.

# Where the app fetches its data assets from, without a trailing slash.
# Default: /data, which is public/data/ as served by Vite.
# Point this at a bucket or CDN when the pipeline writes somewhere else, e.g.
# VITE_DATA_URL=https://data.example.org/wasserlinie
VITE_DATA_URL=/data
