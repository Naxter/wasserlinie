{
  "name": "wasserlinie",
  "version": "0.1.0",
  "private": true,
  "description": "Germany's river network as a living map, driven by real gauge readings.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
